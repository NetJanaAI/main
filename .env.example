# ConvoSpan Intel local development environment
# Copy to .env for local Docker development. Do not commit .env.

NODE_ENV=development
PORT=3001
SERVE_FRONTEND=false
NETJANA_MODE=standalone

# Local infrastructure
DATABASE_URL=postgresql://postgres:password@localhost:5432/b2b_scraper
PGBOUNCER_DATABASE_URL=postgresql://postgres:password@pgbouncer:6432/b2b_scraper
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_CRAFTMYFUNNEL_APP_URL=

# AI providers
# If GOOGLE_API_KEY and OLLAMA_HOST are both blank in development, the app uses
# local demo fallback responses so the full pipeline can be exercised without spend.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=
LITELLM_API_BASE=
LITELLM_MASTER_KEY=

# Auth
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Security
# Development may use the fallback value below. Production must set a strong value.
HMAC_SECRET=dev-safety-fallback-do-not-use-in-prod
ALLOWED_INGEST_IPS=127.0.0.1,::1
ENFORCE_INGEST_AUTH=false
# Admin endpoint protection (standalone mode — not needed when CLERK_SECRET_KEY is set)
# Set to a strong random secret and pass as x-admin-secret header to /api/admin/*
ADMIN_SECRET=

# P0-B: Credential encryption key for data_source_credentials vault.
# Production REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key safe — losing it makes stored credentials unrecoverable.
# Rotate with: npx tsx scripts/migrate-credentials.ts (after setting the new key)
CREDENTIAL_ENCRYPTION_KEY=

# ConvoSpan integration
CONVOSPAN_WEBHOOK_URL=https://<CONVOSPAN_API_HOST>/webhooks/netjana-intel
CONVOSPAN_API_KEY=
NETJANA_HMAC_SECRET=
NETJANA_PULL_API_KEY=
BRAIN_WEBHOOK_URL=
CONVOSPAN_EDGE_WEBHOOK_URL=

# CraftMyFunnel integration
CRAFTMYFUNNEL_API_BASE_URL=
CRAFTMYFUNNEL_API_KEY=
CRAFTMYFUNNEL_NETJANA_HMAC_SECRET=

# Outreach
OUTREACH_DEFAULT_EMAIL=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ConvoSpan Intel <noreply@convospan.com>"
WABA_TOKEN=
WABA_PHONE_NUMBER_ID=
# LinkedIn: auto-dispatch is NOT supported (requires OAuth partner access).
# Leave these blank. LinkedIn outreach is surfaced as copy-to-clipboard in the UI.
LINKEDIN_TOKEN=
LINKEDIN_URN=

# Tender / registry feeds
GEM_XML_FEED_URL=https://gem.gov.in/rss_feed
SANDBOX_API_KEY=

# Monitoring
SENTRY_DSN=
# P1-D: Sentry sampling rates. Default 0.1 (10%). Set to 1.0 only for short debug sessions.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SLACK_WEBHOOK_URL=
# P1-F: PagerDuty Events API v2 routing key (from PagerDuty service integration page)
PAGERDUTY_ROUTING_KEY=
# P2-2: Bearer token to protect /metrics endpoint. Leave blank to disable auth (dev only).
METRICS_BEARER_TOKEN=

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Feature flags
ENABLE_TURBOQUANT=true
DLQ_RETRY_LIMIT=3

